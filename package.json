{
  "name": "farmacia-poupe-mais",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "next dev -p 3000",
    "dev:local": "next dev -p 3000",
    "build": "next build",
    "build:worker": "vinext build",
    "start": "next start",
    "test": "vinext build && node --experimental-loader ./tests/cloudflare-loader.mjs --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "security:scan": "repoguard-ai scan . --config repoguard.config.yml",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.43.0",
